<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<title>Jadwal Kuliah — Gasal 2026</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600;700&display=swap');

  :root{
    --navy: #1e3a5f;
    --navy-deep: #14283f;
    --cream: #f7f4ee;
    --line: #d8d2c4;
    --clay: #b5652f;
    --ink: #2a2a28;
    --muted: #8a8478;
  }

  *{box-sizing:border-box;}
  body{
    margin:0;
    background: var(--cream);
    font-family:'Inter', sans-serif;
    color: var(--ink);
    padding: 28px 14px 40px;
  }

  .sheet{
    max-width: 640px;
    margin: 0 auto;
    background: #fff;
    border: 1px solid var(--line);
  }

  .head{
    background: linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: #fff;
    padding: 26px 24px 22px;
    position: relative;
    overflow: hidden;
  }
  .head::after{
    content:"";
    position:absolute;
    right:-40px; top:-40px;
    width:160px; height:160px;
    border-radius:50%;
    background: rgba(255,255,255,0.06);
  }
  .eyebrow{
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b9c9dc;
    margin: 0 0 6px;
  }
  .title{
    font-family:'Fraunces', serif;
    font-weight:700;
    font-size: 26px;
    margin: 0;
    line-height: 1.15;
  }
  .subtitle{
    margin: 6px 0 0;
    font-size: 13px;
    color: #cdd9e7;
  }
  .head-stats{
    display:flex;
    gap: 18px;
    margin-top: 18px;
    position: relative;
    z-index: 1;
  }
  .stat{
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 4px;
    padding: 8px 12px;
    flex: 1;
  }
  .stat .num{ font-family:'Fraunces', serif; font-size: 19px; font-weight:700; display:block; }
  .stat .lab{ font-size: 10px; letter-spacing:.06em; text-transform:uppercase; color:#b9c9dc; }

  .body{ padding: 20px 22px 8px; }

  .day{
    margin-bottom: 22px;
  }
  .day-label{
    display:flex;
    align-items:baseline;
    gap:10px;
    margin-bottom: 10px;
  }
  .day-name{
    font-family:'Fraunces', serif;
    font-weight:700;
    font-size: 17px;
    color: var(--navy);
  }
  .day-rule{
    flex:1;
    height:1px;
    background: var(--line);
  }
  .day-count{
    font-size: 11px;
    color: var(--muted);
  }

  .course{
    display:flex;
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px dashed var(--line);
  }
  .course:last-child{ border-bottom:none; }

  .time{
    width: 92px;
    flex-shrink:0;
    font-size: 12px;
    color: var(--clay);
    font-weight:600;
    line-height:1.35;
    padding-top:2px;
  }

  .info .name{
    font-size: 14.5px;
    font-weight:600;
    color: var(--ink);
    line-height:1.3;
  }
  .info .meta{
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 2px;
  }
  .flag{
    display:inline-block;
    margin-left:6px;
    font-size: 10px;
    font-weight:700;
    color:#a4372a;
    background:#fbe4e0;
    border-radius:3px;
    padding: 1px 5px;
    vertical-align: middle;
  }

  .foot{
    padding: 16px 22px 22px;
    border-top: 1px solid var(--line);
    display:flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--muted);
  }
  .foot b{ color: var(--navy); font-size: 13px; }
</style>
</head>
<body>

<div class="sheet">
  <div class="head">
    <p class="eyebrow">SIA IAIN Kediri &middot; Kartu Rencana Studi</p>
    <h1 class="title">Jadwal Kuliah</h1>
    <p class="subtitle">Periode 2026 Gasal</p>
    <div class="head-stats">
      <div class="stat"><span class="num">22</span><span class="lab">Total SKS</span></div>
      <div class="stat"><span class="num">24</span><span class="lab">Batas SKS</span></div>
      <div class="stat"><span class="num">3.92</span><span class="lab">IPS Sebelumnya</span></div>
    </div>
  </div>

  <div class="body">

    <div class="day">
      <div class="day-label"><span class="day-name">Senin</span><span class="day-rule"></span><span class="day-count">4 mata kuliah</span></div>
      <div class="course">
        <div class="time">07:00–08:40</div>
        <div class="info"><div class="name">Masrahiyah</div><div class="meta">M-203 &middot; Kelas C &middot; 2 SKS</div></div>
      </div>
      <div class="course">
        <div class="time">10:20–12:00</div>
        <div class="info"><div class="name">Metodologi Penelitian Kuantitatif</div><div class="meta">M-203 &middot; Kelas A &middot; 2 SKS</div></div>
      </div>
      <div class="course">
        <div class="time">13:00–14:40</div>
        <div class="info"><div class="name">Digitalisasi Pembelajaran Bahasa Arab</div><div class="meta">M-202 &middot; Kelas A &middot; 2 SKS</div></div>
      </div>
      <div class="course">
        <div class="time">14:40–16:20</div>
        <div class="info"><div class="name">Tarjamah</div><div class="meta">M-302 &middot; Kelas A &middot; 2 SKS</div></div>
      </div>
    </div>

    <div class="day">
      <div class="day-label"><span class="day-name">Selasa</span><span class="day-rule"></span><span class="day-count">2 mata kuliah</span></div>
      <div class="course">
        <div class="time">10:20–12:00</div>
        <div class="info"><div class="name">Balaghah</div><div class="meta">M-302 &middot; Kelas C &middot; 4 SKS</div></div>
      </div>
      <div class="course">
        <div class="time">13:00–14:40</div>
        <div class="info"><div class="name">Kitabah 2; Akadimiyah</div><div class="meta">M-202 &middot; Kelas C &middot; 2 SKS</div></div>
      </div>
    </div>

    <div class="day">
      <div class="day-label"><span class="day-name">Rabu</span><span class="day-rule"></span><span class="day-count">3 mata kuliah</span></div>
      <div class="course">
        <div class="time">10:20–12:00</div>
        <div class="info"><div class="name">TOAFL</div><div class="meta">M-306 &middot; Kelas A &middot; 2 SKS</div></div>
      </div>
      <div class="course">
        <div class="time">13:00–14:40</div>
        <div class="info"><div class="name">e-Learning</div><div class="meta">M-303 &middot; Kelas A &middot; 2 SKS</div></div>
      </div>
      <div class="course">
        <div class="time">14:40–16:20</div>
        <div class="info"><div class="name">Metode dan Strategi Pembelajaran Bahasa Arab 2</div><div class="meta">M-203 &middot; Kelas A &middot; 2 SKS</div></div>
      </div>
    </div>

    <div class="day">
      <div class="day-label"><span class="day-name">Kamis</span><span class="day-rule"></span><span class="day-count">1 mata kuliah</span></div>
      <div class="course">
        <div class="time">10:20–12:00</div>
        <div class="info"><div class="name">Balaghah</div><div class="meta">M-302 &middot; Kelas C &middot; lanjutan Selasa</div></div>
      </div>
    </div>

    <div class="day">
      <div class="day-label"><span class="day-name">Jumat</span><span class="day-rule"></span><span class="day-count">1 mata kuliah</span></div>
      <div class="course">
        <div class="time">13:00–14:40</div>
        <div class="info"><div class="name">Micro Teaching <span class="flag">Cek Kelas F</span></div><div class="meta">Micro-2 &middot; 2 SKS</div></div>
      </div>
    </div>

  </div>

  <div class="foot">
    <span>Dr. Ratna Saidah, M.Ag &middot; Kurikulum 2023</span>
    <span><b>IPK 3.88</b> &middot; Sem. 5</span>
  </div>
</div>

</body>
</html>
